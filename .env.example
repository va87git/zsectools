# ── SAP NW RFC SDK ──────────────────────────────────────────────────────────
# Path to the SAP NW RFC SDK on the HOST machine (for Docker volume mount)
SAPNWRFC_HOST_PATH=/opt/sap/nwrfcsdk
# Path inside the container where the SDK will be mounted (leave as-is)
SAPNWRFC_CONTAINER_PATH=/opt/sap/nwrfcsdk

# ── SAP NW RFC SDK (Node.js / native) ───────────────────────────────────────
# These must match SAPNWRFC_CONTAINER_PATH
SAPNWRFC_HOME=/opt/sap/nwrfcsdk
LD_LIBRARY_PATH=/opt/sap/nwrfcsdk/lib

# ── WINDOWS ENVIRONMENT (Native Node.js execution via run.bat) ────────────────
# Port for the unified Node.js process (serves both REST API and static frontend)
PORT=3000

# ── DOCKER ENVIRONMENT (Execution via docker-compose) ─────────────────────────
# External host port for the React frontend container (Required by Docker Engine for port binding)
FRONTEND_PORT=5173

# External host port for the Express backend container (Required by Docker Engine for port binding)
BACKEND_PORT=3000

# MANDATORY FOR DOCKER: Allowed CORS origin for backend API requests (Protocol + Host/IP + Port)
# Local access:  http://localhost:5173
# Remote access: http://<SERVER_IP>:5173
CORS_ORIGIN=http://localhost:5173

# ── API BASE URL (FOR BOTH WINDOWS NATIVE & DOCKER) ─────────────────────────
# API Base URL invoked by the browser client.
# This variable is injected into the frontend build (npm run build).
#
# - For Local Access only (on the same machine):
#   VITE_API_BASE=http://localhost:3009
#
# - For Remote / LAN Access (from other devices on the network):
#   Set this to your machine's local IP address (e.g. http://192.168.1.72:3009)
#   Note: Requires rebuilding the frontend (run setup.bat again or npm run build).
VITE_API_BASE=http://localhost:3000

# ── DATABASE CONFIGURATION ───────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=apppassword
